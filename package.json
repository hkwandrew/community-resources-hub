{
	"name": "community-resources-hub",
	"version": "0.1.8",
	"private": true,
	"type": "module",
	"scripts": {
		"styles:build": "sass --no-source-map blocks/opportunity-hub/style.scss:build/opportunity-hub/style.css blocks/member-directory/style.scss:build/member-directory/style.css blocks/video-slider/style.scss:build/video-slider/style.css blocks/newsletter-archives/style.scss:build/newsletter-archives/style.css",
		"styles:watch": "sass --watch --no-source-map blocks/opportunity-hub/style.scss:build/opportunity-hub/style.css blocks/member-directory/style.scss:build/member-directory/style.css blocks/video-slider/style.scss:build/video-slider/style.css blocks/newsletter-archives/style.scss:build/newsletter-archives/style.css",
		"build:js": "wp-scripts build --experimental-modules",
		"start:js": "wp-scripts start --experimental-modules",
		"build": "npm-run-all styles:build build:js",
		"start": "npm-run-all --parallel styles:watch start:js",
		"lint:js": "wp-scripts lint-js --resolve-plugins-relative-to ./node_modules/@wordpress/scripts/node_modules 'blocks/*/view.js' 'blocks/*/src/**/*.js'",
		"lint:css": "wp-scripts lint-style 'blocks/**/*.scss' 'src/styles/**/*.scss'"
	},
	"eslintConfig": {
		"extends": [
			"./node_modules/@wordpress/scripts/config/.eslintrc.js"
		]
	},
	"devDependencies": {
		"npm-run-all": "^4.1.5",
		"sass": "^1.77.8",
		"@wordpress/scripts": "^31.8.0"
	}
}
